# Copy this file to ~/.papers-cool/.env and fill in your values.

# OpenAI-compatible endpoint configuration
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=120

# Default AI output language ('zh' or 'en')
DEFAULT_AI_LANG=zh

# arXiv categories to track at startup (comma-separated)
ARXIV_CATEGORIES=cs.IR,cs.LG,cs.CL,cs.AI

# Data dir (defaults to ~/.papers-cool)
# PAPERS_COOL_DATA_DIR=/Users/tao/.papers-cool

# Server bind. Use 0.0.0.0 if you plan to expose via cloudflared / Tailscale.
HOST=127.0.0.1
PORT=8000

# Set to 1 to disable APScheduler (useful for tests)
DISABLE_SCHEDULER=0

# ---- Mobile / remote access ------------------------------------------------
# Set BOTH to enable the password gate. Leave either empty for open localhost.
# - SITE_PASSWORD: the human-typed password
# - AUTH_SECRET: a long random string the auth cookie carries
#   (anything ~32+ chars: `openssl rand -hex 32` or `uuidgen`)
SITE_PASSWORD=
AUTH_SECRET=

